# Copy this file to .env and replace every placeholder with a unique local-development value.
# MSSQL passwords must satisfy SQL Server's complexity rules.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: set to true only for disposable local environments. All demo accounts share this password.
SEED_DEMO_DATA=false
DEMO_SEED_PASSWORD=replace-with-a-strong-demo-password
# Optional for local development. Without SMTP settings, reset links are written to the API log.
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=CarePoint
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Clinic-local scheduling zone (IANA identifier).
CLINIC_TIME_ZONE=Asia/Amman
# Production deployments should keep this false and run EF migrations before starting the API.
INITIALIZE_DATABASE_ON_STARTUP=false
# Optional comma-separated trusted reverse-proxy IPs, configured as ASP.NET array environment keys.
# ForwardedHeaders__KnownProxies__0=10.0.0.10
