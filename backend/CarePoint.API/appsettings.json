{
  "MedicalDocuments": {
    "StoragePath": "App_Data/medical-documents",
    "MaxBytesPerPatient": 104857600,
    "UploadPermitLimit": 20,
    "UploadWindowMinutes": 60
  },
  "ProfileImages": {
    "StoragePath": "App_Data/profile-images"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClinicTime": {
    "TimeZoneId": "Asia/Amman"
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
